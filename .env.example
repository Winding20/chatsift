# ── AI 服务（任何 OpenAI 兼容端点都能用）────────────────────────
# 智谱：  https://open.bigmodel.cn/api/paas/v4/     模型 glm-4-flash
# OpenAI：https://api.openai.com/v1                模型 gpt-4o-mini
# DeepSeek：https://api.deepseek.com/v1            模型 deepseek-chat
# 本地 Ollama：http://127.0.0.1:11434/v1           模型 qwen2.5:7b
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
AI_MODEL=glm-4-flash

# 旧变量名（ZHIPU_API_KEY / ZHIPU_BASE_URL / ZHIPU_MODEL）仍然可用，
# 但 AI_* 优先。

# ── 服务端口 ────────────────────────────────────────────────
WEB_HOST=127.0.0.1
# 想让手机在同一 Wi-Fi 下访问，改成 0.0.0.0 并设一个密码
# WEB_PASSWORD=change-me
WEB_PORT=5000
WS_HOST=127.0.0.1
WS_PORT=8765

# ── 数据 ────────────────────────────────────────────────────
# 默认 ./data/assistant.db
# DATA_DIR=./data

# ── 分析节奏 ────────────────────────────────────────────────
# 后台多久跑一轮（秒），默认 300
ANALYSIS_INTERVAL=300
# 每轮每个群最多送多少条消息给模型，默认 100
ANALYSIS_WINDOW=100
# 同一批消息最多重试几次，超过就停放，默认 5
ANALYSIS_MAX_ATTEMPTS=5
# 关掉后台自动分析（只采集、不花钱），默认 1
AUTO_ANALYSIS=1
# 单次 AI 请求超时（秒），默认 60
AI_TIMEOUT=60
